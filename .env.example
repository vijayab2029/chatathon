# Google Gemini API key — get one at https://aistudio.google.com/apikey
# The google-genai SDK picks this up automatically.
GEMINI_API_KEY=

# Default model. See "Rate limits" in README.md before changing —
# the free-tier daily quota differs enormously between Flash and Flash-Lite.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
